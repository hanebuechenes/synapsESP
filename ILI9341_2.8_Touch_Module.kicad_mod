(footprint "ILI9341_2.8_Touch_Module_Landscape" (layer "F.Cu")
  (descr "2.8 inch ILI9341 SPI TFT Touch Module (Querformat 86mm x 50mm, 14 Pins links)")
  (tags "Display ILI9341 2.8 SPI Touch Landscape")
  (attr through_hole)
  
  (fp_text reference "REF**" (at 43.0 -5.0) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "ILI9341_2.8_Touch_Module" (at 43.0 55.0) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )

  ; Platinen-Umriss Querformat: Breite 86mm (X: -3.0 bis 83.0), Höhe 50mm (Y: -3.41 bis 46.59)
  (fp_rect (start -3.00 -3.41) (end 83.00 46.59) (layer "F.SilkS") (width 0.12))
  (fp_rect (start -3.25 -3.66) (end 83.25 46.84) (layer "F.CrtYd") (width 0.05))

  ; 4x M3 Montagebohrungen
  (pad "" np_thru_hole circle (at -0.5 -0.91) (size 3.2 3.2) (drill 3.2) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 80.5 -0.91) (size 3.2 3.2) (drill 3.2) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at -0.5 44.09) (size 3.2 3.2) (drill 3.2) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 80.5 44.09) (size 3.2 3.2) (drill 3.2) (layers "*.Cu" "*.Mask"))

  ; Links: Hauptleiste (Pins 1 bis 14)
  (pad "1" thru_hole rect (at 0.00 0.00) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 0.00 2.54) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 0.00 5.08) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at 0.00 7.62) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at 0.00 10.16) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "6" thru_hole circle (at 0.00 12.70) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "7" thru_hole circle (at 0.00 15.24) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "8" thru_hole circle (at 0.00 17.78) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "9" thru_hole circle (at 0.00 20.32) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "10" thru_hole circle (at 0.00 22.86) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "11" thru_hole circle (at 0.00 25.40) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "12" thru_hole circle (at 0.00 27.94) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "13" thru_hole circle (at 0.00 30.48) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "14" thru_hole circle (at 0.00 33.02) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))

  ; Rechts: Zweite Leiste (Pins 15 bis 19)
  (pad "15" thru_hole circle (at 80.00 11.43) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "16" thru_hole circle (at 80.00 13.97) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "17" thru_hole circle (at 80.00 16.51) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "18" thru_hole circle (at 80.00 19.05) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "19" thru_hole circle (at 80.00 21.59) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
)
